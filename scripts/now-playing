#!/bin/bash

max_len=35
play_state="$(playerctl status 2&>1)" > /dev/null
if playerctl status 2&>1 > /dev/null; then
    if [[ $play_state == "Playing" ]]; then
        echo_char='\uf04b'
    elif [[ $play_state == "Paused" ]]; then
        echo_char='\uf04c'
    elif [[ $play_state == "Stopped" ]]; then
        echo_char='\uf04d'
    fi
fi
if playerctl status 2&>1 > /dev/null; then
    test="$(playerctl metadata --format "{{ title }}")"
    if [[ -n "$test" ]]; then
        foo="$(echo -e "$echo_char $test" | sed -E 's/\([0-9]*\)| - YouTube| - Prime Video|\(Official Music Video\)||\[|\]|HD|Full Audio|Lyric  Video|Official Lyric Video|\(Official Video\)//Ig' | cut -c 1-$max_len)"
        >&2 echo $foo'...'
    fi
else
    >&2 echo -e '\uf001 Nothing playing'
fi

>&1 printf "\uf001"
