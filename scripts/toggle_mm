#!/bin/bash

primary=$(xrandr | awk '/ connected / { print $1; exit }')
declare -A positions
count=0

while read -r line; do
    ((count++))
    if [[ "$line" == "$primary" ]]; then
        continue
    fi
    positions["$line"]="$(printf 'right-of\nleft-of\nabove\nbelow\ndisable %s' "$line" | dmenu -p "On which side of $primary do you want to put $line?")"
done < <(xrandr | awk '/ connected / {print $1 }')

echo $count

final_str=(xrandr --output "$primary" --auto)

for key in "${!positions[@]}"; do
    
final_str+=(--output "$key")
    if ! [[ ${positions[$key]} == "disable $key" ]]; then
      final_str+=(--auto "--${positions[$key]}" "$primary")
    else
      final_str+=(--off)
    fi
done

if (( count == 1 )); then
    xrandr --auto    
else
    "${final_str[@]}"
fi
