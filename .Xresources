urxvt.perl-ext-common:      default,matcher,clipboard,url-select,keyboard-select,resize-font,fullscreen,vtwheel
URxvt.cursorBlink: 1
URxvt.cursorUnderline: 1
urxvt.url-select.launcher:  firefox
urxvt.url-select.underline: true
urxvt.keysym.M-u:           perl:url-select:select_next
urxvt.keysym.M-Escape:      perl:keyboard-select:activate
urxvt.keysym.M-s:           perl:keyboard-select:search
urxvt.secondaryScreen: 1
urxvt.secondaryScroll: 0
urxvt.matcher.rend.0: Uline Bold fg5
urxvt.keysym.F11: perl:fullscreen:switch
URxvt.keysym.Shift-Up: command:\033]720;1\007
URxvt.keysym.Shift-Down: command:\033]721;1\007
urxvt*transparent: true
urxvt*shading: 30
urxvt.scrollBar: false
urxvt.boldFont: xft:Inconsolata:weight=400:size=12:antialias=true
urxvt.font: xft:Inconsolata:size=12:antialias=true
urxvt.letterSpace: 0
Xft.rgba: none
URxvt*font: xft:inconsolata:size=10:antialias=true

! special
*.foreground:   #f5f4f0
*.background:   #221e2d
!*.cursorColor:  #d1d1d1
*.cursorColor:  #f5f4f0

! black
*.color0:       #272822
*.color8:       #75715e

! red
*.color1:       #f92672
*.color9:       #f92672

! green
*.color2:       #a6e22e
*.color10:      #a6e22e

! yellow
*.color3:       #f4bf75
*.color11:      #f4bf75

! blue
*.color4:       #66d9ef
*.color12:      #66d9ef

! magenta
*.color5:       #ae81ff
*.color13:      #ae81ff

! cyan
*.color6:       #a1efe4
*.color14:      #a1efe4

! white
*.color7:       #f8f8f2
*.color15:      #f9f8f5
