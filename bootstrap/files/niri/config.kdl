// =========================
// AUTO-GENERATED by niri-split
// Do not edit this file directly.
// Edit the files in conf.d/ instead.
// =========================

// niri config for the Arch side.
//
// This is a deliberate subset of niri's stock config: the compositor's own
// defaults are not read when a config exists, so the binds that make the
// session usable are restated here, and the hardware keys the user asked for
// are set explicitly.
//
// Mod is Super. keyd maps CapsLock to Meta, so either key works.
//
// config.kdl is generated from this directory. Edit these files, then rebuild:
//
//     bun run niri-split
//
// The splitter is vendored at bootstrap/tools/niri-split (MIT). It merges
// `layout`, `input`, `binds` and `animations` into one block each and appends
// everything else in filename order.
// Outputs are arranged by kanshi, not here. It matches a monitor by make,
// model and serial, so the Acer stays to the left of the panel whichever
// connector the dock assigns it. The profiles are in bootstrap/files/kanshi/
// and are installed by 111-kanshi.ts.
//
// With no profile applied — kanshi not running yet, or no monitor pair it
// knows — niri places outputs itself, so a broken kanshi costs the arrangement
// and not the session.

// Qt applications take their colours from qt6ct, which 136-qt-theme.ts points
// at the Breeze-libadwaita dark scheme. Without the platform theme the plugin is
// never loaded and every Qt app falls back to a light Fusion palette, whatever
// qt6ct is configured with.
environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
}

input {

    keyboard {
        xkb {
            // Add layout/variant here later, e.g. layout "us"
        }
    }
    touchpad {
        tap
        // natural-scroll is off: the touchpad scrolls the traditional way.
    }
    // TrackPoint: no pointer acceleration, plus a constant speed bump.
    // libinput's accel-speed is an abstract -1..1 (0 = unchanged), not a literal
    // percentage; 0.55 is what this stick settled on, 0.6 was a touch too fast.
    // With accel-profile "flat" it acts as a constant speed multiplier.
    //
    // None of this reaches the stick until 72-trackpoint.ts has tagged it as a
    // pointing stick: the kernel rejects its variant 0x07, so psmouse calls it a
    // plain mouse, and niri keys `trackpoint` on that classification.
    trackpoint {
        accel-profile "flat"
        accel-speed 0.55
    }
    // Focus windows and outputs when the pointer moves into them. No
    // max-scroll-amount: that qualifier suppresses following for any window the
    // view would have to scroll to reach, which reads as "focus-follows-mouse
    // does nothing" on a layout with columns off to the side.
    focus-follows-mouse
}

// Tighter than niri's default of 16 logical pixels, inner and outer.
layout {

    gaps 8

    // New windows open at half the output width, which is what makes Mod+F a
    // visible toggle: it expands the column to full width and back. niri's
    // stock config sets this to 0.5 too, and it was never copied here — so
    // every window took the size it asked for instead, WezTerm asked for full
    // width, and Mod+F had nothing left to expand.
    //
    // Stock also carries a window-rule forcing WezTerm to an empty
    // default-column-width, to work around its initial-configure bug. That rule
    // is deliberately absent: it is the behaviour this line exists to change.
    default-column-width { proportion 0.5; }

    // The outline on the focused window. niri's default is a light blue
    // (#7fc8ff).
    focus-ring {
        active-color "#7561c9"
    }
}

// Spotify draws its own titlebar and window controls, and niri drawing its own
// border and background behind them puts two edges in the same place — which
// reads as a doubled frame. Turning niri's off for this app alone leaves
// Spotify's, which is the one that cannot be removed.
window-rule {
    match app-id="com.spotify.Client"
    draw-border-with-background false
}

// Round every window's corners. clip-to-geometry clips the window to the
// rounded shape, so its own square corners do not show through.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// The shell, and the notification server inside it.
//
// swaync used to be spawned before qs so that notifications existed when the
// shell registered for them. Quickshell owns org.freedesktop.Notifications
// itself now, and two daemons cannot both hold that name — whichever started
// first would win it, and the control centre's notification list would sit
// permanently empty while swaync drew its own popups over the top.
spawn-at-startup "qs" "-n" "-p" "/home/shan/.config/shell"

// Night light. A helper rather than gammastep directly: gammastep takes a fixed
// latitude and longitude and this machine moves. See 158-night-light.ts.
spawn-at-startup "/usr/local/bin/night-light"

// Output arrangement. kanshi matches a monitor by make, model and serial, so
// the Acer keeps the same side whichever connector the dock gives it. See
// 111-kanshi.ts.
spawn-at-startup "kanshi"

// Session programs that belong to the session rather than to the machine.
//
// These three used to be added by their own steps — 112-wallpaper, 114-udisks,
// 147-idle — which meant 110-niri, running later, rewrote this file and took
// them with it. They are stated here instead, where the shell's spawn already
// is, so that installing this config installs all of it and a later step
// cannot silently drop one.

// The polkit authentication agent. Without one, every action that needs a
// prompt fails with "Not Authorized" instead of asking: enrolling a fingerprint,
// mounting a disk, pkexec. niri does not implement XDG autostart, so the
// package's .desktop file would never run and the binary is spawned directly.
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

spawn-at-startup "/usr/local/bin/wallpaper-random"
spawn-at-startup "udiskie"
spawn-at-startup "swayidle" "-w" "timeout" "600" "/usr/local/bin/idle-hibernate battery" "timeout" "1200" "/usr/local/bin/idle-hibernate ac"

hotkey-overlay {
    // Mod+Shift+/ lists these.
    skip-at-startup
}

// Lid close hibernates rather than sleeping. Hibernation is the only suspend
// this machine does (see 145-hibernate.ts), so this is that same decision
// applied to the lid: a closed laptop is one being carried, and a machine in a
// bag should not be awake.
switch-events {
    lid-close {
        spawn "systemctl" "hibernate";
    }
}

binds {

    // Do not let a fullscreen app's idle inhibit stop swayidle's hibernate.
    // (niri exposes ext-idle-notify-v1; swayidle is configured in 147-idle.ts.)

    Mod+Shift+Slash { show-hotkey-overlay; }

    // Programs
    Mod+T hotkey-overlay-title="Terminal: wezterm" { spawn "wezterm"; }
    Mod+D hotkey-overlay-title="Toggle floating" { toggle-window-floating; }
    // Clipboard history is a vicinae deeplink. `vicinae <link>` is not a
    // subcommand; `deeplink` is.
    Mod+V hotkey-overlay-title="Clipboard history" { spawn "vicinae" "deeplink" "vicinae://launch/clipboard/history"; }
    // Tapping CapsLock or Super emits evdev KEY_F13; see files/keyd/default.conf.
    // niri cannot bind a bare modifier release, so the tap is resolved in keyd
    // and arrives here as that key. This is the launcher.
    //
    // XF86Tools, not F13, and that is not a typo: this keymap maps <FK13> (evdev
    // 183) to [ XF86Tools ], so a bind named F13 parses, validates and then never
    // matches. Check with `xkbcli compile-keymap | grep 'key <FK13>'`.
    XF86Tools hotkey-overlay-title="Launcher: vicinae (Super tap)" { spawn "vicinae" "toggle"; }

    // Hardware keys, as requested:
    // volume in 5% steps, mic mute, brightness in 10% steps.
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- -l 1.0"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0"; }
    // mic-mute flips the PipeWire source mute AND the ALSA capture switch, which
    // is what drives the ThinkPad mic LED (see 110-niri.ts and files/bin/mic-mute).
    XF86AudioMicMute     allow-when-locked=true { spawn "mic-mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "brightness up && qs -p /home/shan/.config/shell ipc call osd brightness"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightness down && qs -p /home/shan/.config/shell ipc call osd brightness"; }

    // Copilot key: keyd turns leftmeta+leftshift+f23 into a plain Pause press.
    // Dictation is installed by 170-dictation.ts.
    Pause allow-when-locked=true { spawn "voxtype" "record" "toggle"; }

    // Session
    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }
    Alt+F4 repeat=false { close-window; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }

    // Focus
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }

    // Lock. focus-column-right is on Mod+Right. `qs ipc` needs -p: without it
    // it looks for the default config at ~/.config/quickshell, which does not
    // exist, and the call never reaches this shell.
    Mod+L hotkey-overlay-title="Lock the screen" { spawn "qs" "-p" "/home/shan/.config/shell" "ipc" "call" "lock" "open"; }

    // Move
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    // Workspaces
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }

    // Layout
    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M       { maximize-window-to-edges; }
    Mod+C       { center-column; }
    Mod+Minus   { set-column-width "-10%"; }
    Mod+Equal   { set-column-width "+10%"; }
    Mod+W       { toggle-column-tabbed-display; }

    // Touchpad gestures (from the niri-gestures build; see 105-niri-gestures.ts).
    // Three fingers open and close the overview; four fingers move around niri.
    // Add natural-scroll=true to the four-finger pair to flip the travel.
    TouchpadSwipe fingers=3 direction="up"    { close-overview; }
    TouchpadSwipe fingers=3 direction="down"  { open-overview; }
    TouchpadSwipe fingers=4 direction="up"    { focus-workspace-up; }
    TouchpadSwipe fingers=4 direction="down"  { focus-workspace-down; }
    TouchpadSwipe fingers=4 direction="left"  { focus-column-left; }
    TouchpadSwipe fingers=4 direction="right" { focus-column-right; }

    // Screenshots
    Print       { screenshot; }
    Ctrl+Print  { screenshot-screen; }
    Alt+Print   { screenshot-window; }
}
