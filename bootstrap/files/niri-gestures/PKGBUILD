# niri with the configurable touch-gesture patch set (niri-wm/niri#3771).
#
# Upstream hardcodes the touchpad gesture finger counts, so the layout this
# repo wants — three fingers for the overview, four to navigate — is not
# reachable from config.kdl. The series in this directory turns the gestures
# into ordinary binds (`TouchpadSwipe fingers=3 direction="up" { ... }`), which
# is what the TouchpadSwipe lines in files/niri/config.kdl use.
#
# The upstream commit is PINNED, not `main`: the series was rebased onto this
# exact commit, so it is the only one it is known to apply to. Bumping it means
# regenerating every patch. See 105-niri-gestures.ts for how it is built.
#
# Exit plan: when #3771 (or an equivalent) lands upstream, delete this package,
# files/niri-gestures/ and 105-niri-gestures.ts, drop the TouchpadSwipe binds,
# and go back to the `niri` package.
#
# provides/conflicts is what lets `pacman -U` replace the repo's niri. The
# provided version is set equal to pkgver, so an ordinary `pacman -Syu` does not
# treat it as something to replace. When the repo's niri moves past 26.04,
# pacman will offer to swap this package back out — that is the intended exit.

pkgname=niri-gestures
pkgver=26.04
pkgrel=1
pkgdesc="A scrollable-tiling Wayland compositor, with the configurable touch-gesture patch set"
arch=('x86_64')
url="https://github.com/niri-wm/niri"
license=('GPL-3.0-or-later')
depends=('cairo' 'glib2' 'glibc' 'libdisplay-info' 'libgcc' 'libinput'
         'libpipewire' 'libxkbcommon' 'mesa' 'pango' 'pixman' 'seatd'
         'systemd-libs' 'xdg-desktop-portal-impl')
makedepends=('clang' 'git')
provides=('niri' "niri=$pkgver" 'wayland-compositor')
conflicts=('niri')

# !lto is load-bearing, not a preference.
#
# makepkg's `lto` option puts -flto=auto into CFLAGS, so libspa's C shim
# (libspa-rs-reexports.a, built from static_fns.c and friends) is compiled to
# GCC LTO bytecode — the objects are full of .gnu.lto_* sections. rustup's rustc
# links with rust-lld, which understands LLVM bitcode but not GCC's bytecode, so
# it cannot pull anything out of that archive and the link dies with:
#
#   undefined symbol: libspa_rs_type_video_format
#   undefined symbol: spa_format_parse_libspa_rs
#   ...
#
# Without -flto those files are ordinary ELF objects and link normally. This was
# a real failure, not a theory: see the note in 105-niri-gestures.ts.
options=('!lto')

# The commit the series was rebased onto (the parent of its first commit).
_base=2c82b77a7116a1241ea2fd41dd008ff00b609aae

source=("niri-$_base.tar.gz::https://github.com/niri-wm/niri/archive/$_base.tar.gz"
        0001-feat-configurable-touch-gestures.patch
        0002-feat-deferred-tap-to-focus-via-focus-on-touch.patch
        0003-feat-flick-to-throw-fling-a-touch-dragged-window-to-.patch
        0004-feat-richer-touch-gesture-debug-telemetry.patch
        0005-fix-cancel-client-touches-when-a-gesture-claims-the-.patch
        0006-fix-touchpad-swipe-bind-directions-follow-physical-f.patch
        0007-fix-overview-gesture-binds-perform-the-bound-action.patch
        0008-fix-second-finger-tap-toggles-floating-during-a-touc.patch
        0009-fix-cancelled-overview-touch-no-longer-counts-as-a-t.patch
        0010-docs-correct-the-touchpad-swipe-trigger-distance-uni.patch
        0011-config-add-touchpad-three-finger-drag-option.patch)

# The tarball is a moving GitHub archive of one commit, so there is nothing
# stable to hash without downloading it; the patches are hashed.
sha256sums=('SKIP'
