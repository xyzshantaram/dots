prepare() {
    cd "niri-$_base"

    # In numeric order; the series was generated against this exact commit, so a
    # failure here means the pinned base and the patches have drifted apart.
    local p
    for p in "${srcdir}"/000*.patch; do
        patch -Np1 --no-backup-if-mismatch -i "$p"
    done
}

build() {
    cd "niri-$_base"
    # cargo comes from rustup, installed for the account rather than as a
    # package, so it cannot be named in makedepends and makepkg will not put it
    # on PATH. lib.ts's ensureRustup() is what guarantees it exists.
    export PATH="$HOME/.cargo/bin:$PATH"
    # --locked keeps the committed Cargo.lock; the patches add no dependencies.
    # Network is still needed for the smithay git dependency, so this is not
    # --frozen (which would also mean --offline).
    cargo build --release --locked
}

package() {
    cd "niri-$_base"

    install -Dm755 target/release/niri           "$pkgdir/usr/bin/niri"
    install -Dm755 resources/niri-session        "$pkgdir/usr/bin/niri-session"

    install -Dm644 resources/niri.service          "$pkgdir/usr/lib/systemd/user/niri.service"
    install -Dm644 resources/niri-shutdown.target  "$pkgdir/usr/lib/systemd/user/niri-shutdown.target"

    install -Dm644 resources/niri.desktop          "$pkgdir/usr/share/wayland-sessions/niri.desktop"
    install -Dm644 resources/niri-portals.conf     "$pkgdir/usr/share/xdg-desktop-portal/niri-portals.conf"

    install -Dm644 README.md                       "$pkgdir/usr/share/doc/niri/README.md"
    install -Dm644 resources/default-config.kdl    "$pkgdir/usr/share/doc/niri/default-config.kdl"

    install -d "$pkgdir/usr/share/bash-completion/completions" \
               "$pkgdir/usr/share/fish/vendor_completions.d" \
               "$pkgdir/usr/share/zsh/site-functions"
    target/release/niri completions bash > "$pkgdir/usr/share/bash-completion/completions/niri"
    target/release/niri completions fish > "$pkgdir/usr/share/fish/vendor_completions.d/niri.fish"
    target/release/niri completions zsh  > "$pkgdir/usr/share/zsh/site-functions/_niri"
}
