# Temporary read-write window on the drawer. Installed by sensible-bootstrap
# dualboot-utils/drawer-mount.ts.
#
#   systemctl start drawer-rw    read-write now, back to read-only in 10 min
#   systemctl stop drawer-rw     read-only now
#   systemctl status drawer-rw   time remaining
#
# THE GUARD
#
# ExecStartPre asks hibernate-mark whether a *different* installed OS still
# owns a hibernation image. If it does, its filesystem has unwritten state in
# RAM; writing it from here and then resuming over there is how a home
# directory is lost. The unit refuses before touching anything.
#
# The trailing `exit 0` matters: hibernate-mark is optional, and a missing
# binary must not make the drawer permanently unwritable. Absence of the check
# is not evidence of danger, so only a positive detection blocks.
#
# RemainAfterExit is what makes RuntimeMaxSec mean something. `mount` returns
# in milliseconds, so without it the timer would fire immediately and there
# would be no window at all. With it, the unit stays active for ten minutes,
# then systemd stops it and ExecStop returns the drawer to read-only.
[Unit]
Description=Drawer read-write window
Documentation=file:/etc/systemd/system/drawer-rw.service

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeMaxSec=600
ExecStartPre=/usr/bin/sh -ec '[ -x /usr/local/bin/hibernate-mark ] && exec /usr/local/bin/hibernate-mark other; exit 0'
ExecStart=/usr/bin/mount -o remount,rw /mnt/drawer
ExecStop=/usr/bin/mount -o remount,ro /mnt/drawer

[Install]
WantedBy=multi-user.target
