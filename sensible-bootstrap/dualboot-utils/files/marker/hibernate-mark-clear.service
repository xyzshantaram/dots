[Unit]
Description=Clear the hibernation marker from the systemd-boot menu
# A normal boot means there is no hibernation image to resume, so any marker
# left over from an interrupted hibernation is stale. Resuming from hibernate
# does not re-run boot units; the post-sleep hook clears it in that case.
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/hibernate-mark clear

[Install]
WantedBy=multi-user.target
