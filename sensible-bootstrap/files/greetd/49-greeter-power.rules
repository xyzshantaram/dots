// Allow the greetd greeter user to use tuigreet's power menu.
//
// Installed by sensible-bootstrap 117-greetd.ts. Installed into
// /etc/polkit-1/rules.d/, where it must sort BEFORE 50-default.rules: polkit
// evaluates rules in order and the first one to return a value wins, so the
// "49-" prefix is what makes this take effect rather than being overridden.
//
// Why a rule is needed at all: greetd runs its greeter as a system service,
// outside any logind session. polkit's default rules grant power actions to
// local *active session* users, so the greeter matches none of them and the
// buttons do nothing.
//
// What tuigreet actually runs (its defaults, all prefixed with setsid):
//   shutdown -> shutdown -h now          -> login1.power-off
//   reboot   -> shutdown -r now          -> login1.reboot
//   suspend  -> loginctl suspend         -> login1.suspend
//   hibernate-> loginctl hibernate       -> login1.hibernate
//
// The -multiple-sessions variants are included because the plain action is not
// the one checked when another session is open, and the greeter should not stop
// working because someone is logged in on tty2.
//
// Scope, stated plainly: this lets one nologin system account power the machine
// off without a password. That is the point of a greeter — anyone standing at
// the console can already do this at the firmware level — and `greeter` cannot
// be logged into. Nothing else is granted.

polkit.addRule(function (action, subject) {
    var powerActions = [
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions",
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions",
        "org.freedesktop.login1.suspend",
        "org.freedesktop.login1.suspend-multiple-sessions",
        "org.freedesktop.login1.hibernate",
        "org.freedesktop.login1.hibernate-multiple-sessions",
    ];

    if (subject.user === "greeter" && powerActions.indexOf(action.id) !== -1) {
        return polkit.Result.YES;
    }
});
